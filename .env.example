# kano-proxy self-hosting configuration (docs/deployment.md).
# Copy to .env, fill in real values, and never commit it.

########## Ingress ##########
DOMAIN=your-domain.example
ACME_EMAIL=you@example.com
APP_URL=https://your-domain.example
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/callback

########## Database (compose builds DATABASE_URL from these) ##########
POSTGRES_USER=kano
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>
POSTGRES_DB=kano_proxy

########## Sign-in ##########
# A Google OAuth client with GOOGLE_REDIRECT_URI registered as its redirect URI.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

########## Secrets ##########
# Generate once and keep them. A changed TOKEN_ENCRYPTION_KEY makes every stored
# upstream account unreadable; a changed SESSION_SECRET signs everyone out.
SESSION_SECRET=<generate: openssl rand -hex 32>
TOKEN_ENCRYPTION_KEY=<generate: openssl rand -base64 32>
CLI_TOKEN_SECRET=<generate: openssl rand -hex 32>

########## Optional ##########
# Provider OAuth client ids. Unset uses the pinned defaults in code.
#CLAUDE_CODE_OAUTH_CLIENT_ID=
#CODEX_OAUTH_CLIENT_ID=
#GROK_OAUTH_CLIENT_ID=
# Antigravity is a confidential client: set both or neither.
#ANTIGRAVITY_OAUTH_CLIENT_ID=
#ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Where the in-app changelog reads release notes from. Empty turns the page off.
GITHUB_REPO=yufeng-kano/kano-proxy
#GITHUB_TOKEN=

#REQUEST_LOG_RETENTION_DAYS=90
#UPSTREAM_FIRST_BYTE_TIMEOUT_MS=180000

RUST_LOG=info
