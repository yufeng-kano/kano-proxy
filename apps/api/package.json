{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler/state",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply kano-proxy --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply kano-proxy --remote",
    "db:local:status": "wrangler d1 execute kano-proxy --local --persist-to .wrangler/state --command \"SELECT 'users' AS t, count(*) AS n FROM users UNION ALL SELECT 'accounts', count(*) FROM upstream_accounts UNION ALL SELECT 'keys', count(*) FROM api_keys;\""
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "wrangler": "^4.0.0"
  }
}
