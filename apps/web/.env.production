# Production build (`vite build` runs in production mode and loads this file).
#
# Everything here is PUBLIC: Vite inlines VITE_* values into the client bundle
# at build time. Never put a secret in a VITE_ variable.

# VITE_API_ORIGIN is intentionally left unset. The Worker serves /api/*,
# /openai/*, and /anthropic/* on the same host as Pages, so the SPA calls
# same-origin. Set it only if the API is ever split onto another hostname.
# VITE_API_ORIGIN=

# Contact address shown in the public login footer.
VITE_CONTACT_EMAIL=yuufeng.kano@gmail.com
