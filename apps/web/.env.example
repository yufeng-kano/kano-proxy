# Template for the web app's Vite environment files.
#
# Vite never loads this file — copy it to the one you need:
#   .env.development  → `pnpm --filter web dev`   (committed)
#   .env.production   → `pnpm --filter web build` (committed)
#   .env.*.local      → personal overrides        (gitignored)
#
# Everything here is PUBLIC: Vite inlines VITE_* values into the client bundle
# at build time. Never put a secret in a VITE_ variable — API tokens, OAuth
# client secrets, and session secrets belong in apps/api/.dev.vars or Cloudflare
# secrets instead.

# Origin of the Worker API.
# Local dev: the wrangler dev server, so the session cookie host matches OAuth.
# Production: leave unset — Pages and the Worker share a hostname (same-origin).
VITE_API_ORIGIN=http://127.0.0.1:8787

# Contact address shown in the public login footer.
VITE_CONTACT_EMAIL=<contact-email>
